<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5"> 
        <h2 class="mb-3 text-center">Signup on Wanderlust</h2>
        <form action="/signup" method="POST" class="needs-validation shadow-sm p-4 rounded border bg-white" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" type="text" class="form-control" placeholder="Choose a username" required>
                <div class="valid-feedback">Looks good!</div>  
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control" placeholder="Enter your email" required>  
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" type="password" class="form-control" placeholder="Create a password" required>  
            </div>

            <button class="btn btn-success w-100 py-2 mt-2">Signup</button>
        </form>
    </div>
</div>